{
  "$schema": "https://turbo.build/schema.json",
    "globalEnv": [
    "STAGE",
    "BASALF_PROD_COGNITO_CLIENT_ID",
    "BASALF_PROD_COGNITO_CLIENT_SECRET",
    "BASALF_PROD_COGNITO_ISSUER",
    "BASALF_PROD_COGNITO_REGION",
    "BASALF_PROD_NEXTAUTH_SECRET",
    "BASALF_PROD_NEXTAUTH_URL",
    "BASALF_PROD_AUTH_COOKIE_DOMAIN",
    "BASALF_PROD_USER_MGT_BFF_URL",
    "BASALF_DEV_COGNITO_CLIENT_ID",
    "BASALF_DEV_COGNITO_CLIENT_SECRET",
    "BASALF_DEV_COGNITO_ISSUER",
    "BASALF_DEV_COGNITO_REGION",
    "BASALF_DEV_NEXTAUTH_SECRET",
    "BASALF_DEV_NEXTAUTH_URL",
    "BASALF_DEV_AUTH_COOKIE_DOMAIN",
    "BASALF_DEV_USER_MGT_BFF_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
