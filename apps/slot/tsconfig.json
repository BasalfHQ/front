{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/apis": ["../../packages/apis/src"],
      "@repo/auth-ui": ["../../packages/auth-ui/src"],
      "@repo/config": ["../../packages/config/src"],
      "@repo/ui": ["../../packages/ui/src"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@repo/esco": ["../../packages/esco/src"],
      "@repo/esco/*": ["../../packages/esco/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
